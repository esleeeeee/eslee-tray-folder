<Window x:Class="Eslee.TrayFolder.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Folder 설정"
        Width="640"
        Height="640"
        MinWidth="580"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Closing="OnClosing">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="23" FontWeight="SemiBold" Text="Tray Folder 설정" />
        <TextBlock Grid.Row="1"
                   Margin="0,8,0,14"
                   Foreground="#FF667085"
                   Text="앱별 실행 파일과 트레이 모드를 설정하고 저장 버튼으로 한 번에 저장합니다. 트레이 모드는 앱이 연결되면 자동으로 적용됩니다."
                   TextWrapping="Wrap" />

        <ScrollViewer Grid.Row="2"
                      Margin="0,0,-8,0"
                      Padding="0,0,8,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppSectionsPanel" />
        </ScrollViewer>

        <TextBlock x:Name="MessageText"
                   Grid.Row="3"
                   Margin="0,13,0,0"
                   Foreground="#FFC43D3D"
                   TextWrapping="Wrap" />

        <StackPanel Grid.Row="4"
                    Margin="0,13,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0" Padding="18,7" Content="닫기" Click="OnCloseClick" />
            <Button Padding="18,7" Content="저장" IsDefault="True" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
