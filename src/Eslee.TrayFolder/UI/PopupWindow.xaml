<Window x:Class="Eslee.TrayFolder.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Folder"
        Width="360"
        Height="278"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated"
        Closing="OnClosing">
    <Border Margin="12"
            Padding="18"
            CornerRadius="22"
            Background="#FFFAFCFF"
            BorderBrush="#1A1E293B"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#FF172033" Text="Tray Folder" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#FF778198" Text="eslee apps" />
                </StackPanel>
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Content="설정"
                        Click="OnSettingsClick" />
            </Grid>

            <Border Grid.Row="1" Background="#FFE5E9F0" />

            <UniformGrid Grid.Row="2" Margin="0,18,0,0" Columns="3" Rows="1">
                <Button x:Name="AutoPowerButton"
                        Width="96"
                        Height="142"
                        Padding="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnAutoPowerClick">
                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="68" Height="68" CornerRadius="18" Background="#FFEAF2FF">
                            <Grid>
                                <TextBlock x:Name="FallbackIconText"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="#FF2C6BED"
                                           Text="A" />
                                <Image x:Name="AppIconImage" Width="46" Height="46" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AppNameText"
                                   Margin="0,9,0,0"
                                   MaxWidth="90"
                                   HorizontalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="AutoPower"
                                   TextAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Margin="0,5,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Margin="0,0,5,0" Fill="#FF9AA3B2" />
                            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#FF667085" Text="확인 중" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
