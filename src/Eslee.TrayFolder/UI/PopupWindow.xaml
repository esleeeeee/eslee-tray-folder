<Window x:Class="Eslee.TrayFolder.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tray Folder"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated"
        Closing="OnClosing">
    <Border Margin="12"
            Padding="18"
            CornerRadius="22"
            Background="#FFFAFCFF"
            BorderBrush="#1A1E293B"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.24" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="#FF172033" Text="Tray Folder" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#FF778198" Text="eslee apps" />
                </StackPanel>
                <Button x:Name="SettingsButton"
                        Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Content="설정"
                        Click="OnSettingsClick" />
            </Grid>

            <Border Grid.Row="1" Background="#FFE5E9F0" />

            <UniformGrid x:Name="AppsGrid" Grid.Row="2" Margin="0,18,0,0" Columns="3" />
        </Grid>
    </Border>
</Window>
